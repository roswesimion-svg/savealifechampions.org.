{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://save-a-life-project-original-backen.vercel.app/api/$1"
    },
    {
      "source": "/((?!api|assets|favicon.ico|favicon.png).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
